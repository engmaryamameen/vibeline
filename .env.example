NODE_ENV=development

# server
PORT=5001
API_PREFIX=/v1
JWT_SECRET=replace-with-long-random-secret
AUTH_CREDENTIAL_SECRET=replace-with-a-different-long-random-secret
OAUTH_STATE_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibeline
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
APP_URL=http://localhost:3002
# Enable only when requests arrive through a trusted reverse proxy/load balancer.
TRUST_PROXY=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_SECURE=false
INVITE_FROM_EMAIL=mailer@example.com

# OAuth. Leave all three values for a provider empty to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Media storage. Relative paths resolve against the server working directory.
MEDIA_STORAGE_DIR=.data/media

# WebRTC calling. STUN alone works on the same network; TURN is required for
# most real-world NATs. Provide CALL_TURN_SECRET to mint time-limited
# credentials (coturn static-auth-secret), or a long-lived user/password pair.
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
CALL_TURN_SECRET=
CALL_TURN_USERNAME=
CALL_TURN_PASSWORD=
CALL_TURN_TTL_SECONDS=600

# Browser push. Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# web
NEXT_PUBLIC_API_BASE_URL=

# Optional assistant model provider. Configure all three together.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
