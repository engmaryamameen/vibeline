NODE_ENV=development

# server
PORT=5001
API_PREFIX=/v1
JWT_SECRET=replace-with-long-random-secret
AUTH_CREDENTIAL_SECRET=replace-with-a-different-long-random-secret
OAUTH_STATE_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibeline
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
APP_URL=http://localhost:3002
# Enable only when requests arrive through a trusted reverse proxy/load balancer.
TRUST_PROXY=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_SECURE=false
INVITE_FROM_EMAIL=mailer@example.com

# OAuth. Leave all three values for a provider empty to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# web
NEXT_PUBLIC_API_BASE_URL=
